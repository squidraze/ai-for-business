# Copy to `.env.local` (git-ignored by `*.local`) and fill in.
# NEVER put a real token in `.env` — that file is not ignored and would be committed.
#
# Only `VITE_`-prefixed variables reach the browser bundle. Everything here is
# read at build/serve time by Vite; the values below are only ever used by the
# DEV host (`src/dev/`), never by the app running inside the native WebView —
# on a device the `init` message carries the rest, and the session never reaches
# the WebView at all (see "The session lives in the host" below).

# --- The mock `init` payload, used when the page runs in a browser tab -------

# Sent as the `X-Company-ID` header on every request the host performs.
# Default: 00000000-0000-0000-0000-000000000001
VITE_DEV_COMPANY_ID=

# The signed-in user. Also picks the realtime channel (`ai:user-<uuid>`).
# Default: 00000000-0000-0000-0000-000000000002
VITE_DEV_USER_UUID=

# Conversation to open. `new` starts an empty thread. Default: new
# With the mock backend on, two seeded threads exist and can be opened here (or
# from the DEV panel's "Open a thread" section):
#   dev00000-0000-4000-8000-000000000001  a thread with history and an attachment
#   dev00000-0000-4000-8000-000000000002  a thread that exists but is empty
VITE_DEV_THREAD_ID=

# `light` | `dark`. Default: whatever the OS prefers. The DEV panel toggles it
# at runtime, so this is only the starting value.
VITE_DEV_THEME=

# BCP-47 locale in the `init` payload. Default: the browser's.
VITE_DEV_LOCALE=

# App version string in the `init` payload. Default: 0.0.0-dev
VITE_DEV_APP_VERSION=

# --- The session lives in the host ------------------------------------------
#
# The web app makes no network calls. It posts `http.request` over the bridge and
# the host performs the call with the session it holds — because the production
# page is loaded from `file://`, so its origin is `null`, and the API's CORS
# allowlist answers `400 Disallowed CORS origin` to that (`*` is not available to
# it either, since it sends `allow-credentials: true`).
#
# So the two variables below belong to the DEV **host**, not to the app: they are
# the credentials it signs a passed-through request with. Neither is in the
# `init` payload any more, and neither is read at all while VITE_DEV_MOCK_API is
# on. `VITE_DEV_TOKEN` can hold a real access token — keep it in `.env.local`.

# Default: dev-token
VITE_DEV_TOKEN=

# REST origin the dev host points a real request at. Default: http://localhost:8000
VITE_DEV_BASE_URL=

# --- Offline mode -----------------------------------------------------------

# The mock backend (`src/dev/mockBackend.ts`) is **ON by default** in `npm run
# dev`: the dev host answers every `http.request` from fixtures and streams a
# fake AI run over a fake Centrifugo socket, so nothing leaves the browser. That
# is the default because a browser tab has no TMS to talk to and this file is not
# in the repo — an opt-in flag meant the harness quietly made real, refused
# requests instead.
#
# Set to `0` (or false/no/off) and the host performs each request for real
# against VITE_DEV_BASE_URL with VITE_DEV_TOKEN. Anything else — including
# empty — keeps the mock. Either way the app itself issues nothing: the only
# transport it has is the bridge, exactly as on a device.
#
# What it serves, and how to drive it:
#   - the DEV panel (top right) switches what the *next* run does: streams a
#     reply, ends in `ai.run.error`, is cancelled mid-stream, or pauses on an
#     `ai.action.pending` approval card. It also opens the seeded threads above.
#   - the panel's Transport section injects the bridge's own failures: "Network:
#     offline" fails every `http.request` with `ok: false` / `ERR_NETWORK`,
#     "Fail the next request" arms a single one (a loaded thread, a failed send),
#     and "Lose the session" pushes `session.lost`.
#   - "Pick files (as the host)" runs the native attachment path — the host holds
#     the file and answers `attachment.upload` with a uuid. The composer's own
#     attach button uses the plain-browser `<input type="file">` fallback.
#   - a slash command overrides the panel for one send: `/error`, `/cancel`,
#     `/hitl`, `/tool <name>` (emits an `ai.tool_call` for a generative block).
VITE_DEV_MOCK_API=

# --- Runtime tuning (applies on a device too) -------------------------------

# How long an in-flight AI run may stay silent before the stream gives up, in ms.
# Read by src/realtime/aiEvents.ts. Default: 60000
VITE_AI_RUN_IDLE_TIMEOUT_MS=

# --- Not a Vite variable ----------------------------------------------------
#
# MOBILE_DIR — where `npm run sync` delivers the bundle. A shell variable, not
# read from this file. Default: ../mobile (the sibling folder of webview/).
