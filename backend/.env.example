# --- core ---
# Secret that signs user JWTs (and attachment download links). Change it.
JWT_SECRET=change-me
# Where SQLite (app.db), attachments and Telegram sessions live. Default: backend/data
DATA_DIR=./data
# Public base URL of this backend as the phone sees it (attachment links, Google OAuth redirect)
BACKEND_PUBLIC_URL=http://localhost:8000

# --- AI ---
# OpenAI (or compatible) API key. Empty = fake mode (canned streamed replies).
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL, e.g. https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# Chat Completions model with tool calling
AI_MODEL=gpt-4.1-mini
# 1 = force the canned fake model even when a key is set ("/tool", "/hitl" commands)
AI_FAKE=0

# --- Centrifugo (must match docker-compose / centrifugo/config.json) ---
# HTTP API used to publish. Under docker compose this is overridden to http://centrifugo:8000/api
CENTRIFUGO_API_URL=http://localhost:8001/api
# Centrifugo HTTP API key (= api_key / CENTRIFUGO_API_KEY on the Centrifugo side)
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
# HMAC secret for client connection JWTs (= token_hmac_secret_key / CENTRIFUGO_TOKEN_HMAC_SECRET_KEY)
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=dev-centrifugo-hmac-secret
# WebSocket URL handed to clients in the connection-token response
CENTRIFUGO_PUBLIC_URL=ws://localhost:8001/connection/websocket

# --- Telegram connector (https://my.telegram.org → API development tools) ---
# Telegram app api_id (integer)
TELEGRAM_API_ID=
# Telegram app api_hash
TELEGRAM_API_HASH=

# --- Gmail connector (Google Cloud OAuth "Web application" client) ---
# OAuth client id; authorised redirect URI: {BACKEND_PUBLIC_URL}/api/v1/connectors/gmail/callback
GOOGLE_CLIENT_ID=
# OAuth client secret
GOOGLE_CLIENT_SECRET=
