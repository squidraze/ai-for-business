#!/bin/sh
# Validates commit messages against docs/git/commits.md (Conventional Commits).
# Enable once per clone: git config core.hooksPath .githooks

msg_file="$1"
header=$(sed -n '/^[^#]/{p;q;}' "$msg_file")

# Merge, revert and fixup/squash messages generated by git are allowed as is.
case "$header" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

branch=$(git symbolic-ref --short -q HEAD)
if [ "$branch" = "main" ] || [ "$branch" = "prod" ]; then
  echo "commit-msg: do not commit directly to '$branch'." >&2
  echo "Create a branch: git switch -c <type>/<short-description> (see docs/git/branches.md)" >&2
  exit 1
fi

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
if ! printf '%s\n' "$header" | grep -Eq "^($types)(\([a-z0-9][a-z0-9_/-]*\))?!?: [^ ].*[^.]$"; then
  echo "commit-msg: invalid header: \"$header\"" >&2
  echo "Expected: <type>(<scope>): <summary>   e.g. feat(instagram): list Direct conversations" >&2
  echo "Types: $types. No trailing period. See docs/git/commits.md" >&2
  exit 1
fi

if [ "${#header}" -gt 72 ]; then
  echo "commit-msg: header is ${#header} chars, max 72." >&2
  exit 1
fi
