# Скопируй этот файл в .env (рядом с ним) и заполни.
# Без ключей тоже запустится: ИИ ответит заглушкой, коннекторы просто не подключатся.

# ===== ИИ =====
# Подходит любой OpenAI-совместимый API. Варианты:
#   OpenAI (платно):        ключ https://platform.openai.com/api-keys, BASE_URL пусто, MODEL=gpt-4.1-mini
#   Google Gemini (бесплатно с лимитами): ключ https://aistudio.google.com/apikey,
#                           BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/, MODEL=gemini-3.5-flash-lite
#   Groq (бесплатно с лимитами): ключ https://console.groq.com/keys,
#                           BASE_URL=https://api.groq.com/openai/v1, MODEL=llama-3.3-70b-versatile
#   OpenRouter:             ключ https://openrouter.ai/keys, BASE_URL=https://openrouter.ai/api/v1,
#                           MODEL=openai/gpt-4.1-mini (или бесплатная модель с суффиксом :free)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Модель должна поддерживать tool calling (вызов инструментов)
AI_MODEL=gpt-4.1-mini

# ===== Telegram =====
# https://my.telegram.org → войти по номеру → "API development tools" → создать приложение
# (название и описание любые). Оттуда взять api_id (число) и api_hash.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ===== Gmail =====
# https://console.cloud.google.com:
#  1. Создать проект → "APIs & Services" → "Library" → включить "Gmail API".
#  2. "OAuth consent screen": тип External, оставить в режиме Testing,
#     в "Test users" добавить Gmail-адрес, который будешь подключать.
#  3. "Credentials" → "Create credentials" → "OAuth client ID" → тип "Web application",
#     в "Authorized redirect URIs" добавить: http://localhost:8000/api/v1/connectors/gmail/callback
#  4. Скопировать Client ID и Client secret сюда.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Почта для кодов входа (Gmail SMTP) =====
# Коды подтверждения почты и сброса пароля отправляются письмом через Gmail.
# Если SMTP_USER или SMTP_PASSWORD пустые — письма не отправляются (режим разработки),
# а код пишется в лог бэкенда строкой "[dev mail] to=... purpose=... code=123456"
# (смотреть: docker compose logs -f backend).
# Как получить пароль приложения:
#  1. Войти в Gmail-аккаунт, с которого будут уходить письма → https://myaccount.google.com/security
#  2. Включить "2-Step Verification" (двухэтапную аутентификацию) — без неё пароли приложений недоступны.
#  3. Открыть https://myaccount.google.com/apppasswords → ввести любое имя (например forBusiness) → Create.
#  4. Google покажет пароль из 16 букв — вставить его в SMTP_PASSWORD (пробелы можно оставить).
# Письма уходят с адреса SMTP_USER, отправитель подписан как SMTP_FROM_NAME.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=forBusiness
# Сколько минут действует код, через сколько секунд можно запросить новый, сколько попыток ввода
EMAIL_CODE_TTL_MINUTES=15
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# ===== Вход через Google =====
# Тот же проект в https://console.cloud.google.com → "APIs & Services" → "Credentials".
#  1. Web-клиент (тип "Web application") уже есть — это GOOGLE_CLIENT_ID выше (для Gmail).
#     Его же приложение передаёт как webClientId — в мобилке это отдельная настройка.
#  2. "Create credentials" → "OAuth client ID" → тип "Android":
#     package name ai.forbusiness.demo, SHA-1 — отпечаток ключа подписи. Для debug-сборки:
#     cd mobile/android && ./gradlew signingReport  (строка SHA1 у варианта debug).
#     Для релизной сборки и Google Play нужны отдельные Android-клиенты с их SHA-1.
#  3. "Create credentials" → "OAuth client ID" → тип "iOS": bundle ID ai.forbusiness.demo.
#  4. Сюда через запятую — Client ID всех трёх клиентов (Web, Android, iOS).
#     Бэкенд примет ID-токен, только если он выпущен для одного из них.
#     Если пусто — принимается только GOOGLE_CLIENT_ID.
GOOGLE_SIGNIN_CLIENT_IDS=

# ===== Вход через Apple =====
# Bundle ID приложения (как в mobile/app.json). Токен входа Apple должен быть выпущен для него.
# В Apple Developer → Identifiers у этого App ID должна быть включена возможность "Sign in with Apple".
APPLE_BUNDLE_ID=ai.forbusiness.demo

# ===== Остальное можно не трогать =====
# Секрет для токенов входа — поменяй на любую длинную строку
JWT_SECRET=change-me-to-any-long-random-string
# Адрес бэкенда, каким его видит телефон. Должен совпадать с redirect URI в Google (без /api/...)
BACKEND_PUBLIC_URL=http://localhost:8000
# Где хранить базу, файлы и сессии Telegram
DATA_DIR=./data
# Centrifugo (стрим ответов ИИ). Значения должны совпадать с centrifugo/config.json
CENTRIFUGO_API_URL=http://localhost:8001/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=dev-centrifugo-hmac-secret
CENTRIFUGO_PUBLIC_URL=ws://localhost:8001/connection/websocket
# 1 = отвечать заглушкой даже при наличии ключа
AI_FAKE=0
