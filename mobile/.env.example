# Backend base URL (no trailing slash). With `adb reverse tcp:8000 tcp:8000` localhost works on a device.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Debug builds only: load the chat from the Vite dev server instead of assets/webchat/index.html
# (e.g. http://localhost:5173 with `adb reverse tcp:5173 tcp:5173`). Leave empty to use the bundle.
EXPO_PUBLIC_WEBCHAT_DEV_URL=

# --- UI animation ---
# Cross-fade duration (ms) when a screen switches between loading / error / empty / content.
EXPO_PUBLIC_STATE_FADE_MS=800
# One pass of the skeleton shimmer highlight (ms).
EXPO_PUBLIC_SKELETON_SHIMMER_MS=1200

# --- Network ---
# Max wait for one API request (ms). After it the screen shows an error with Retry, never an endless skeleton.
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Max wait for a file upload (ms).
EXPO_PUBLIC_UPLOAD_TIMEOUT_MS=120000
# After this long on a loading skeleton, a "taking longer than usual" hint appears (ms).
EXPO_PUBLIC_SLOW_LOADING_MS=8000

# --- Tasks (schedules) ---
# How often the Tasks tab badge ("needs approval" count) refreshes while the app is open (ms).
EXPO_PUBLIC_PENDING_POLL_MS=60000

# --- Вход через Google ---
# Где взять: Google Cloud Console → APIs & Services → Credentials → Create credentials → OAuth client ID.
# Web client ID — тот же, что GOOGLE_CLIENT_ID в backend/.env (бэкенд проверяет id_token по нему).
# Без него кнопка Google неактивна.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Для Android в .env ничего не нужно, но в той же консоли создай клиент типа Android:
# package name ai.forbusiness.demo + SHA-1 отладочного ключа (cd android && ./gradlew signingReport).
# iOS client ID — клиент типа iOS с bundle id ai.forbusiness.demo.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Перевёрнутый iOS client ID (com.googleusercontent.apps.XXXX) — URL-схема для iOS-сборки.
# Оставь пустым, если собираешь только Android.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
